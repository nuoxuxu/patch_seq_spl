manifest {
    name = 'patch_seq_spl'
    description = 'Patch-seq single cell splicing analysis pipeline'
    author = 'Your Name'
    homePage = 'https://github.com/yourusername/patch_seq_spl'
    version = '1.0.0'
    mainScript = 'main.nf'
    nextflowVersion = '>=21.10.0'
}

params {
    // Inputs
    dataset = 'sorensen'
    config_file = './config/config.yaml'
    
    // Output directories
    output_dir = './proc'
    results_dir = './results'
    logs_dir = './logs'
    
    // Analysis parameters
    group_by = 'three'
    
    // Resource allocation
    small_job_cpus = 2
    small_job_memory = '4.GB'
    
    medium_job_cpus = 8
    medium_job_memory = '16.GB'
    
    large_job_cpus = 16
    large_job_memory = '64.GB'
    
    // Help
    help = false
}

profiles {
    standard {
        process.executor = 'local'
        process.cpus = params.medium_job_cpus
        process.memory = params.medium_job_memory
    }
    
    slurm {
        process.executor = 'slurm'
        process.queue = 'default'
        process.cpus = params.medium_job_cpus
        process.memory = params.medium_job_memory
        process.time = '24h'
    }
    
    niagara {
        process.executor = 'slurm'
        process.queue = 'compute'
        process.cpus = params.large_job_cpus
        process.memory = params.large_job_memory
        process.time = '24h'
        process.clusterOptions = '--account=<your_account>'
    }
    
    docker {
        docker.enabled = true
        process.container = 'biocontainers/biocontainers:latest'
    }
    
    singularity {
        singularity.enabled = true
        process.container = 'library://biocontainers/biocontainers:latest'
    }
}

// Process-specific configuration
process {
    withName: STAR_INDEX {
        cpus = params.large_job_cpus
        memory = params.large_job_memory
        time = '4h'
    }
    
    withName: STAR_ALIGN {
        cpus = params.large_job_cpus
        memory = params.large_job_memory
        time = '6h'
    }
    
    withName: TABS_TO_ADATA {
        cpus = params.medium_job_cpus
        memory = params.medium_job_memory
        time = '2h'
    }
    
    withName: PREPROCESS {
        cpus = params.medium_job_cpus
        memory = params.medium_job_memory
        time = '2h'
    }
    
    withName: MERGE_BAMS {
        cpus = params.large_job_cpus
        memory = params.large_job_memory
        time = '3h'
    }
    
    withName: INDEX_BAMS {
        cpus = params.medium_job_cpus
        memory = params.medium_job_memory
        time = '1h'
    }
}

// Execution settings
executor {
    $local {
        cpus = 1
        memory = '4 GB'
        queueSize = 4
    }
    
    $slurm {
        queueSize = 100
        submitRateLimit = '10 sec'
        pollInterval = '30 sec'
    }
}

// Reporting
report {
    enabled = true
    file = "${params.logs_dir}/execution_report.html"
}

timeline {
    enabled = true
    file = "${params.logs_dir}/timeline.html"
}

trace {
    enabled = true
    file = "${params.logs_dir}/trace.txt"
    fields = 'process,status,exit,realtime,cpus,memory'
}

dag {
    enabled = true
    file = "${params.logs_dir}/dag.html"
}

// Catch exit codes
shell = ['/bin/bash', '-euo', 'pipefail']
